# API keys. Copy this file to `.env` and fill in the real values.
#
# `.env` is gitignored and must stay that way. Note that Vite inlines
# VITE_* variables into the built bundle, so the key ships inside the APK —
# see the note in src/services/tmdb.ts about what that does and does not protect.

# TMDB v3 API key. Long-lived and does not expire.
# https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=

# OMDb API key. Adds IMDb ratings and a few fields TMDB omits.
# https://www.omdbapi.com/apikey.aspx
VITE_OMDB_API_KEY=
